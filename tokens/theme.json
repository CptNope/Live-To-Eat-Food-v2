{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        {
          "slug": "butter",
          "name": "Butter",
          "color": "#FFF6CF"
        },
        {
          "slug": "lemon",
          "name": "Lemon",
          "color": "#FFE586"
        },
        {
          "slug": "yolk",
          "name": "Yolk",
          "color": "#FFC53D"
        },
        {
          "slug": "pistachio",
          "name": "Pistachio",
          "color": "#DCEFC8"
        },
        {
          "slug": "matcha",
          "name": "Matcha",
          "color": "#B3DA94"
        },
        {
          "slug": "peach",
          "name": "Peach",
          "color": "#FFD8C2"
        },
        {
          "slug": "vinyl",
          "name": "Vinyl",
          "color": "#FFFFFF"
        },
        {
          "slug": "oat",
          "name": "Oat",
          "color": "#EFEADB"
        },
        {
          "slug": "basil",
          "name": "Basil",
          "color": "#1E3B2A"
        },
        {
          "slug": "olive",
          "name": "Olive",
          "color": "#46583E"
        },
        {
          "slug": "leaf",
          "name": "Leaf",
          "color": "#2B6436"
        },
        {
          "slug": "tomato",
          "name": "Tomato",
          "color": "#B3311A"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display — Bagel Fat One",
          "fontFamily": "\"Bagel Fat One\", \"Arial Rounded MT Bold\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bagel Fat One",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/bagel-fat-one.woff2"
              ]
            }
          ]
        },
        {
          "slug": "reading",
          "name": "Reading — Figtree",
          "fontFamily": "Figtree, \"Segoe UI\", system-ui, -apple-system, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Figtree",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/figtree.woff2"
              ]
            },
            {
              "fontFamily": "Figtree",
              "fontWeight": "400 700",
              "fontStyle": "italic",
              "src": [
                "file:./assets/fonts/figtree-italic.woff2"
              ]
            }
          ]
        },
        {
          "slug": "interface",
          "name": "Interface — Bricolage Grotesque",
          "fontFamily": "\"Bricolage Grotesque\", Figtree, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontWeight": "400 800",
              "fontStretch": "85% 100%",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/bricolage-grotesque.woff2"
              ]
            }
          ]
        },
        {
          "slug": "hand",
          "name": "Tina’s hand — Shantell Sans",
          "fontFamily": "\"Shantell Sans\", \"Comic Neue\", cursive",
          "fontFace": [
            {
              "fontFamily": "Shantell Sans",
              "fontWeight": "500 800",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/shantell-sans.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "meta",
          "name": "Meta",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "lede",
          "name": "Lede",
          "size": "1.375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.375rem"
          }
        },
        {
          "slug": "display-s",
          "name": "Display S",
          "size": "1.375rem",
          "fluid": false
        },
        {
          "slug": "display-m",
          "name": "Display M",
          "size": "2.25rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "display-l",
          "name": "Display L",
          "size": "4rem",
          "fluid": {
            "min": "2.25rem",
            "max": "4rem"
          }
        },
        {
          "slug": "display-xl",
          "name": "Display XL",
          "size": "6rem",
          "fluid": {
            "min": "2.75rem",
            "max": "6rem"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "XS",
          "size": "8px"
        },
        {
          "slug": "20",
          "name": "S",
          "size": "14px"
        },
        {
          "slug": "30",
          "name": "M",
          "size": "22px"
        },
        {
          "slug": "40",
          "name": "L",
          "size": "30px"
        },
        {
          "slug": "50",
          "name": "XL",
          "size": "clamp(32px, 4vw, 56px)"
        },
        {
          "slug": "60",
          "name": "Sheet",
          "size": "clamp(56px, 8vw, 112px)"
        }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "lift",
          "name": "Sticker lift",
          "shadow": "0 1px 1px rgb(30 59 42 / .10), 0 8px 18px -8px rgb(30 59 42 / .32)"
        },
        {
          "slug": "lift-hi",
          "name": "Sticker peel",
          "shadow": "0 2px 2px rgb(30 59 42 / .10), 0 18px 30px -12px rgb(30 59 42 / .38)"
        }
      ]
    },
    "custom": {
      "radius": {
        "sheet": "36px",
        "sticker": "24px",
        "tag": "12px",
        "pill": "999px"
      },
      "dieCut": {
        "border": "5px",
        "kissCut": "1.5px solid rgb(30 59 42 / .16)"
      },
      "tilt": {
        "min": "-8deg",
        "max": "8deg",
        "logoMax": "3deg"
      },
      "motion": {
        "ease": "cubic-bezier(.16, 1, .3, 1)",
        "peel": "500ms"
      }
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1240px"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|butter",
      "text": "var:preset|color|basil"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|reading",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.05"
        },
        "color": {
          "text": "var:preset|color|basil"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display-xl",
          "lineHeight": "0.95"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|display-l"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|display-m"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|display-s"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|leaf"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|basil"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|basil",
          "text": "var:preset|color|vinyl"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|interface",
          "fontWeight": "700",
          "fontSize": "1.0625rem"
        },
        "border": {
          "radius": "var:custom|radius|pill"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "26px",
            "right": "26px"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|leaf"
          }
        }
      }
    }
  }
}
